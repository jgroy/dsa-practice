class Solution {
    public int maxProfit(int[] prices) {
        int profit =0;
        int small = prices[0];
        int maxprofit = 0;
        for(int i=0;i<prices.length;i++){
            if(prices[i]<small){
            small = prices[i];
            }
            profit =prices[i]-small;
            if(profit>maxprofit){
            maxprofit = prices[i]-small;
            }
        }
        return maxprofit;
    }
}